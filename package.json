{
  "name": "finalapi",
  "version": "3.0.0",
  "description": "An OAuth secured API using AWS Serverless Hosting and Lambda Functions",
  "author": "Gary Archer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "login": "sls login",
    "lint": "eslint .",
    "start": "rm -rf dist && tsx tools/start.ts",
    "build": "rm -rf dist && NODE_OPTIONS='--import tsx' npx rollup --config build/rollup.config.ts",
    "testsetup": "./test/scripts/testsetup.sh",
    "test": "./test/scripts/test.sh",
    "loadtest": "./test/scripts/loadtest.sh",
    "deploy": "./deploy.sh",
    "remove": "sls remove --stage deployed"
  },
  "dependencies": {
    "@middy/core": "^7.9.2",
    "inversify": "^8.2.3",
    "jose": "^6.2.12",
    "node-cache": "^5.1.2",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "serverless": "^4.42.0",
    "serverless-offline": "^14.8.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "workspaces": [
    "build",
    "test"
  ]
}
